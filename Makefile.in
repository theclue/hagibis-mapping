# Makefile.in — generated by ./configure
# Standard GNU targets: all, install, clean, distclean, dist, check

prefix      ?= @PREFIX@
bindir      ?= @BINDIR@

CARGO       ?= @CARGO@
SWIFTC      ?= @SWIFTC@
CLANG       ?= @CLANG@
TARGET_OS   ?= @TARGET_OS@
CARGO_FLAGS ?= @CARGO_FLAGS@
TARGET_DIR  ?= @TARGET_DIR@
PROJECT_ROOT?= @PROJECT_ROOT@

APP_NAME    := HagibisMapping
APP_DISPLAY := "Hagibis Mapping"
APP_VERSION := 0.1.0
GUI_DIR     := $(PROJECT_ROOT)/gui

# ── Default target ────────────────────────────────────────────────────────
.PHONY: all
all: build
ifeq ($(TARGET_OS),macos)
ifneq ($(SWIFTC),:)
	@$(MAKE) gui
endif
endif
	@echo "Build complete."

.PHONY: build
build:
	$(CARGO) build $(CARGO_FLAGS)

# ── macOS GUI ─────────────────────────────────────────────────────────────
.PHONY: gui
gui: build
	@echo "Building GUI..."
	HELPER_O=$$(ls $(TARGET_DIR)/build/hagibis_hub_mapper-*/out/*nsevent_helper*.o 2>/dev/null | head -1); \
	$(CLANG) -c $(GUI_DIR)/elevate.c -o $(GUI_DIR)/elevate.o; \
	$(SWIFTC) -o $(GUI_DIR)/$(APP_NAME) \
	    $(GUI_DIR)/main.swift $(GUI_DIR)/elevate.o \
	    $(TARGET_DIR)/libhagibis_hub_mapper.a $$HELPER_O \
	    -framework IOKit -framework CoreGraphics \
	    -framework Foundation -framework AppKit -framework Security; \
	rm -f $(GUI_DIR)/elevate.o

# ── macOS bundle + DMG ────────────────────────────────────────────────────
.PHONY: dist
dist: gui
ifeq ($(TARGET_OS),macos)
	@echo "Packaging .app bundle..."
	ICONSET=$(GUI_DIR)/AppIcon.iconset; mkdir -p $$ICONSET; \
	for sz in 16 32 64 128 256 512; do \
	    sips -z $$sz $$sz $(GUI_DIR)/icon.png --out $$ICONSET/icon_$${sz}x$${sz}.png >/dev/null 2>&1; \
	done; \
	iconutil -c icns $$ICONSET -o $(GUI_DIR)/AppIcon.icns 2>/dev/null; rm -rf $$ICONSET
	APP_BUNDLE=$(GUI_DIR)/$(APP_NAME).app; \
	rm -rf $$APP_BUNDLE; mkdir -p $$APP_BUNDLE/Contents/MacOS $$APP_BUNDLE/Contents/Resources; \
	cp $(GUI_DIR)/$(APP_NAME) $$APP_BUNDLE/Contents/MacOS/$(APP_NAME); \
	cp $(GUI_DIR)/AppIcon.icns $$APP_BUNDLE/Contents/Resources/AppIcon.icns; \
	cp $(GUI_DIR)/hub.png $$APP_BUNDLE/Contents/Resources/hub.png 2>/dev/null || true; \
	cp $(GUI_DIR)/Info.plist $$APP_BUNDLE/Contents/Info.plist; \
	xattr -cr $$APP_BUNDLE 2>/dev/null || true; \
	codesign --force --deep --sign - --options runtime \
	    --entitlements $(GUI_DIR)/entitlements.plist $$APP_BUNDLE; \
	if ! codesign --display --verbose=4 $$APP_BUNDLE 2>&1 | grep -q 'flags=.*runtime'; then \
	    echo "ERROR: bundle not signed with hardened runtime" >&2; exit 1; \
	fi
	@echo "Bundle ready: $$APP_BUNDLE"
	@echo "Creating DMG..."
	DMG_FILE=$(GUI_DIR)/$(APP_NAME)-$(APP_VERSION).dmg; \
	STAGE=$(GUI_DIR)/dmg-staging; \
	rm -rf $$STAGE $$DMG_FILE; mkdir -p $$STAGE; \
	cp -R $$APP_BUNDLE $$STAGE/; \
	ln -s /Applications $$STAGE/Applications; \
	hdiutil create -volname $(APP_DISPLAY) -srcfolder $$STAGE -ov -format UDZO $$DMG_FILE >/dev/null; \
	rm -rf $$STAGE; \
	tccutil reset All com.gabrielebaldassarre.override-hub >/dev/null 2>&1 || true
	@echo "DMG ready: $$DMG_FILE"
else
	@echo "dist target is macOS-only."
endif

# ── Install / uninstall ───────────────────────────────────────────────────
.PHONY: install
install: all
ifeq ($(TARGET_OS),macos)
	@echo "Installing $(APP_NAME).app to /Applications..."
	cp -R $(GUI_DIR)/$(APP_NAME).app /Applications/
else
	install -d $(DESTDIR)$(bindir)
	install $(TARGET_DIR)/hagibis_hub_mapper $(DESTDIR)$(bindir)
endif

.PHONY: uninstall
uninstall:
ifeq ($(TARGET_OS),macos)
	rm -rf /Applications/$(APP_NAME).app
else
	rm -f $(DESTDIR)$(bindir)/hagibis_hub_mapper
endif

# ── Clean ─────────────────────────────────────────────────────────────────
.PHONY: clean
clean:
	cargo clean
	rm -rf $(GUI_DIR)/$(APP_NAME) $(GUI_DIR)/$(APP_NAME).app
	rm -rf $(GUI_DIR)/AppIcon.icns $(GUI_DIR)/AppIcon.iconset
	rm -rf $(GUI_DIR)/*.dmg $(GUI_DIR)/dmg-staging
	rm -rf $(GUI_DIR)/*.o

.PHONY: distclean
distclean: clean
	rm -f Makefile

# ── Test ──────────────────────────────────────────────────────────────────
.PHONY: check test
check test:
	$(CARGO) test $(CARGO_FLAGS)

.PHONY: help
help:
	@echo "Standard targets:"
	@echo "  all        Build Rust crate + macOS GUI"
	@echo "  build      Build Rust crate only"
	@echo "  dist       Create .app bundle + DMG (macOS only)"
	@echo "  install    Install to /Applications (macOS) or \$$bindir"
	@echo "  uninstall  Remove installed files"
	@echo "  clean      Remove build artifacts"
	@echo "  distclean  clean + remove Makefile"
	@echo "  check      Run tests"
	@echo ""
	@echo "Variables:"
	@echo "  RELEASE=1  Build with optimisations"
